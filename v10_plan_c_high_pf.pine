//@version=6
strategy("XAUUSD Plan C - High PF V10",
         shorttitle="V10",
         overlay=true,
         default_qty_type=strategy.fixed,
         default_qty_value=0.02,
         initial_capital=30000000,
         commission_type=strategy.commission.cash_per_order,
         commission_value=5,
         slippage=2,
         pyramiding=0,
         currency=currency.USD)

// ============================================================================
// 🎯 PLAN C: BALANCED OPTIMIZATION for PF 4.0
// ============================================================================
// Target: Profit Factor 3.5-4.2 | Win Rate 65-72% | Profit 30-42%
// Filters: Daily Trend + Volume + Confirmation + ATR 4.0
// ============================================================================

// CORE SETTINGS
atrPeriod = input.int(12, "ATR Period", group="Core")
atrMultiplier = input.float(4.0, "ATR Multiplier", minval=1.0, maxval=10.0, step=0.1, group="Core", tooltip="V8: 3.0 | V9a: 3.5 | V10: 4.0 (very selective)")

// FILTERS
useDailyFilter = input.bool(true, "✅ Daily Trend Filter", group="Filters", tooltip="Only trade WITH daily trend")
useVolumeFilter = input.bool(true, "✅ Volume Filter", group="Filters", tooltip="Only trade high volume breakouts")
volumeMultiplier = input.float(1.0, "Volume Multiplier", minval=0.5, maxval=3.0, step=0.1, group="Filters", tooltip="Volume > MA × this value")
useConfirmation = input.bool(true, "✅ Confirmation Candle", group="Filters", tooltip="Wait 1 bar after flip")

// DAILY FILTER SETTINGS
dailyATRPeriod = input.int(12, "Daily ATR Period", group="Daily Filter")
dailyATRMulti = input.float(3.0, "Daily ATR Multiplier", minval=1.0, maxval=10.0, step=0.1, group="Daily Filter")

// RISK MANAGEMENT
stopLossPercent = input.float(4.0, "Stop Loss %", step=0.1, group="Risk")
useTrailingStop = input.bool(true, "Enable Trailing Stop", group="Risk")
trailActivation = input.float(4.5, "Trail Activation %", step=0.5, group="Risk")
trailOffset = input.float(2.5, "Trail Offset %", step=0.5, group="Risk")

// DAILY LIMITS (OPTIONAL)
enableDailyTarget = input.bool(false, "Enable Daily Target", group="Daily Limits")
dailyTarget = input.float(3.0, "Daily Target %", step=0.5, group="Daily Limits")
enableDailyStop = input.bool(false, "Enable Daily Stop Loss", group="Daily Limits")
dailyStopLoss = input.float(8.0, "Daily Stop Loss %", step=0.5, group="Daily Limits")

// TRADE DIRECTION
allowLong = input.bool(true, "Allow Long", group="Direction")
allowShort = input.bool(false, "Allow Short", group="Direction")

// ============================================================================
// SUPERTREND - 15M TIMEFRAME
// ============================================================================

[supertrend, direction] = ta.supertrend(atrMultiplier, atrPeriod)
bullish = direction < 0
bearish = direction > 0
bullishFlip = ta.change(direction) < 0
bearishFlip = ta.change(direction) > 0

// ============================================================================
// DAILY TREND FILTER
// ============================================================================

[dailyST, dailyDir] = request.security(syminfo.tickerid, "D", ta.supertrend(dailyATRMulti, dailyATRPeriod))
dailyBullish = dailyDir < 0
dailyBearish = dailyDir > 0

dailyTrendOK = not useDailyFilter or (allowLong and dailyBullish) or (allowShort and dailyBearish)

// ============================================================================
// VOLUME FILTER
// ============================================================================

volMA = ta.sma(volume, 20)
highVolume = volume > volMA * volumeMultiplier
volumeOK = not useVolumeFilter or highVolume

// ============================================================================
// CONFIRMATION LOGIC
// ============================================================================

var bool pendingLong = false
var bool pendingShort = false

if useConfirmation
    if bullishFlip and dailyTrendOK and volumeOK
        pendingLong := true
        pendingShort := false
    else if bearishFlip and dailyTrendOK and volumeOK
        pendingShort := true
        pendingLong := false

    if pendingLong and close < supertrend
        pendingLong := false

    if pendingShort and close > supertrend
        pendingShort := false
else
    pendingLong := bullishFlip and dailyTrendOK and volumeOK
    pendingShort := bearishFlip and dailyTrendOK and volumeOK

confirmedLong = pendingLong and close > supertrend and dailyTrendOK and volumeOK
confirmedShort = pendingShort and close < supertrend and dailyTrendOK and volumeOK

// ============================================================================
// DAILY P&L TRACKING
// ============================================================================

var float dayStartEquity = strategy.initial_capital
var int currentDay = 0

newDay = dayofmonth(time) != currentDay
if newDay
    dayStartEquity := strategy.equity
    currentDay := dayofmonth(time)

dailyPnL = strategy.equity - dayStartEquity
dailyPnLPercent = (dailyPnL / dayStartEquity) * 100

hitDailyTarget = enableDailyTarget and dailyPnLPercent >= dailyTarget
hitDailyStop = enableDailyStop and dailyPnLPercent <= -dailyStopLoss
dailyLimitReached = hitDailyTarget or hitDailyStop

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

longEntry = allowLong and confirmedLong and strategy.position_size == 0 and not dailyLimitReached
shortEntry = allowShort and confirmedShort and strategy.position_size == 0 and not dailyLimitReached

if longEntry
    pendingLong := false

if shortEntry
    pendingShort := false

// ============================================================================
// POSITION MANAGEMENT
// ============================================================================

var float entry = na
var float stopLoss = na
var float trailStop = na

if longEntry
    entry := close
    stopLoss := close * (1 - stopLossPercent / 100)
    trailStop := na
    strategy.entry("L", strategy.long)

if shortEntry
    entry := close
    stopLoss := close * (1 + stopLossPercent / 100)
    trailStop := na
    strategy.entry("S", strategy.short)

// ============================================================================
// TRAILING STOP
// ============================================================================

if strategy.position_size > 0 and useTrailingStop
    activationPrice = entry * (1 + trailActivation / 100)
    if close >= activationPrice
        newTrail = close * (1 - trailOffset / 100)
        trailStop := na(trailStop) ? newTrail : math.max(trailStop, newTrail)

if strategy.position_size < 0 and useTrailingStop
    activationPrice = entry * (1 - trailActivation / 100)
    if close <= activationPrice
        newTrail = close * (1 + trailOffset / 100)
        trailStop := na(trailStop) ? newTrail : math.min(trailStop, newTrail)

// ============================================================================
// EXIT MANAGEMENT
// ============================================================================

if strategy.position_size > 0
    if not na(trailStop)
        strategy.exit("X", "L", stop=math.max(stopLoss, trailStop))
    else
        strategy.exit("X", "L", stop=stopLoss)
    if bearishFlip
        strategy.close("L", comment="Reverse")
        trailStop := na
        pendingLong := false

if strategy.position_size < 0
    if not na(trailStop)
        strategy.exit("X", "S", stop=math.min(stopLoss, trailStop))
    else
        strategy.exit("X", "S", stop=stopLoss)
    if bullishFlip
        strategy.close("S", comment="Reverse")
        trailStop := na
        pendingShort := false

if dailyLimitReached and strategy.position_size != 0
    strategy.close_all(comment="Daily Limit")
    trailStop := na
    pendingLong := false
    pendingShort := false

// ============================================================================
// PLOTTING
// ============================================================================

plot(bullish ? supertrend : na, "15m Up", color.lime, 3)
plot(bearish ? supertrend : na, "15m Down", color.red, 3)

plot(useDailyFilter ? dailyST : na, "Daily ST", dailyBullish ? color.new(color.green, 70) : color.new(color.maroon, 70), 2, plot.style_line)

plotshape(longEntry, "Buy", shape.triangleup, location.belowbar, color.lime, size=size.normal, text="BUY")
plotshape(shortEntry, "Sell", shape.triangledown, location.abovebar, color.red, size=size.normal, text="SELL")

plotshape(useConfirmation and pendingLong and not confirmedLong, "Pending", shape.circle, location.belowbar, color.new(color.yellow, 50), size=size.tiny)
plotshape(useConfirmation and pendingShort and not confirmedShort, "Pending", shape.circle, location.abovebar, color.new(color.yellow, 50), size=size.tiny)

bgcolor(dailyBullish and useDailyFilter ? color.new(color.lime, 97) : dailyBearish and useDailyFilter ? color.new(color.red, 97) : na)

plot(strategy.position_size != 0 ? stopLoss : na, "SL", color.red, 2, plot.style_cross)
plot(strategy.position_size != 0 and not na(trailStop) ? trailStop : na, "Trail", color.orange, 2, plot.style_circles)

// Volume bar coloring
barcolor(useVolumeFilter and highVolume ? color.new(color.blue, 70) : na)

// ============================================================================
// DASHBOARD
// ============================================================================

if barstate.islast
    var t = table.new(position.top_right, 2, 15, bgcolor=color.new(color.black, 90), border_width=1)

    table.cell(t, 0, 0, "V10 PLAN C", text_color=color.white, bgcolor=color.new(color.purple, 60))
    table.cell(t, 1, 0, "", bgcolor=color.new(color.purple, 60))

    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    wrCol = wr >= 70 ? color.lime : wr >= 65 ? color.yellow : wr >= 60 ? color.orange : color.red
    table.cell(t, 0, 1, "Win Rate", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(wr, "#.#") + "%", text_color=wrCol)

    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0
    pfCol = pf >= 4.0 ? color.lime : pf >= 3.5 ? color.yellow : pf >= 3.0 ? color.orange : pf >= 2.5 ? color.gray : color.red
    table.cell(t, 0, 2, "Profit Factor", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(pf, "#.##"), text_color=pfCol)

    table.cell(t, 0, 3, "Trades", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white)

    profit = (strategy.netprofit / strategy.initial_capital) * 100
    profCol = profit >= 40 ? color.lime : profit >= 30 ? color.yellow : profit >= 25 ? color.orange : profit > 15 ? color.gray : color.red
    table.cell(t, 0, 4, "Profit %", text_color=color.white)
    table.cell(t, 1, 4, str.tostring(profit, "#.#") + "%", text_color=profCol)

    dd = strategy.max_drawdown / strategy.initial_capital * 100
    ddCol = dd < 6 ? color.lime : dd < 8 ? color.yellow : dd < 12 ? color.orange : color.red
    table.cell(t, 0, 5, "Max DD", text_color=color.white)
    table.cell(t, 1, 5, str.tostring(dd, "#.#") + "%", text_color=ddCol)

    avgWin = strategy.wintrades > 0 ? (strategy.grossprofit / strategy.wintrades / strategy.initial_capital * 100) : 0
    table.cell(t, 0, 6, "Avg Win %", text_color=color.white)
    table.cell(t, 1, 6, str.tostring(avgWin, "#.##") + "%", text_color=color.lime)

    avgLoss = strategy.losstrades > 0 ? (strategy.grossloss / strategy.losstrades / strategy.initial_capital * 100) : 0
    table.cell(t, 0, 7, "Avg Loss %", text_color=color.white)
    table.cell(t, 1, 7, str.tostring(avgLoss, "#.##") + "%", text_color=color.red)

    rrRatio = avgLoss > 0 ? avgWin / avgLoss : 0
    rrCol = rrRatio >= 3.0 ? color.lime : rrRatio >= 2.5 ? color.yellow : rrRatio >= 2.0 ? color.orange : color.red
    table.cell(t, 0, 8, "Avg R:R", text_color=color.white)
    table.cell(t, 1, 8, str.tostring(rrRatio, "#.##") + ":1", text_color=rrCol)

    table.cell(t, 0, 9, "15m Trend", text_color=color.white)
    table.cell(t, 1, 9, bullish ? "BULL" : "BEAR", text_color=bullish ? color.lime : color.red)

    table.cell(t, 0, 10, "Daily Trend", text_color=color.white)
    table.cell(t, 1, 10, dailyBullish ? "BULL" : "BEAR", text_color=dailyBullish ? color.lime : color.red)

    vol = useVolumeFilter ? (highVolume ? "HIGH ✓" : "LOW ✗") : "OFF"
    volCol = highVolume ? color.lime : color.red
    table.cell(t, 0, 11, "Volume", text_color=color.white)
    table.cell(t, 1, 11, vol, text_color=useVolumeFilter ? volCol : color.gray)

    pos = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "NONE"
    posCol = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(t, 0, 12, "Position", text_color=color.white)
    table.cell(t, 1, 12, pos, text_color=posCol)

    dpCol = dailyPnLPercent >= dailyTarget ? color.lime : dailyPnLPercent >= 0 ? color.yellow : dailyPnLPercent <= -dailyStopLoss ? color.red : color.orange
    table.cell(t, 0, 13, "Daily P&L", text_color=color.white)
    table.cell(t, 1, 13, str.tostring(dailyPnLPercent, "#.##") + "%", text_color=dpCol)

    filters = str.tostring(int(useDailyFilter)) + "/" + str.tostring(int(useVolumeFilter)) + "/" + str.tostring(int(useConfirmation))
    table.cell(t, 0, 14, "Filters (D/V/C)", text_color=color.white)
    table.cell(t, 1, 14, filters, text_color=color.yellow)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longEntry, "LONG", "Buy XAUUSD @ {{close}}")
alertcondition(shortEntry, "SHORT", "Sell XAUUSD @ {{close}}")
alertcondition(bearishFlip and strategy.position_size > 0, "Exit Long", "Close Long @ {{close}}")
alertcondition(bullishFlip and strategy.position_size < 0, "Exit Short", "Close Short @ {{close}}")
