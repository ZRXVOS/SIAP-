//@version=6
strategy("XAUUSD Plan A - Optimized V9a",
         shorttitle="V9a",
         overlay=true,
         default_qty_type=strategy.fixed,
         default_qty_value=0.02,
         initial_capital=30000000,
         commission_type=strategy.commission.cash_per_order,
         commission_value=5,
         slippage=2,
         pyramiding=0,
         currency=currency.USD)

// ============================================================================
// 🎯 PLAN A: SIMPLE OPTIMIZATION
// ============================================================================
// Change 1: ATR Multi 3.0 → 3.5 (less signals, higher quality)
// Change 2: Confirmation candle (wait 1 bar after flip)
// Expected: Win Rate 58-62%, Profit 20-28%
// ============================================================================

// CORE SETTINGS
atrPeriod = input.int(12, "ATR Period", group="Core")
atrMultiplier = input.float(3.5, "ATR Multiplier", minval=1.0, maxval=10.0, step=0.1, group="Core", tooltip="V8: 3.0 | V9a: 3.5 (less signals)")

// CONFIRMATION FILTER
useConfirmation = input.bool(true, "✅ Use Confirmation Candle", group="Core", tooltip="Wait 1 bar after Supertrend flip")

// RISK MANAGEMENT
stopLossPercent = input.float(4.0, "Stop Loss %", step=0.1, group="Risk")
useTrailingStop = input.bool(true, "Enable Trailing Stop", group="Risk")
trailActivation = input.float(4.5, "Trail Activation %", step=0.5, group="Risk")
trailOffset = input.float(2.5, "Trail Offset %", step=0.5, group="Risk")

// DAILY LIMITS (OPTIONAL)
enableDailyTarget = input.bool(false, "Enable Daily Target", group="Daily", tooltip="Optional - test without first")
dailyTarget = input.float(3.0, "Daily Target %", step=0.5, group="Daily")
enableDailyStop = input.bool(false, "Enable Daily Stop Loss", group="Daily", tooltip="Optional - test without first")
dailyStopLoss = input.float(8.0, "Daily Stop Loss %", step=0.5, group="Daily")

// TRADE DIRECTION
allowLong = input.bool(true, "Allow Long", group="Direction")
allowShort = input.bool(false, "Allow Short", group="Direction")

// ============================================================================
// SUPERTREND CALCULATION
// ============================================================================

[supertrend, direction] = ta.supertrend(atrMultiplier, atrPeriod)
bullish = direction < 0
bearish = direction > 0
bullishFlip = ta.change(direction) < 0
bearishFlip = ta.change(direction) > 0

// ============================================================================
// CONFIRMATION LOGIC - NEW IN V9a
// ============================================================================

var bool pendingLong = false
var bool pendingShort = false

if useConfirmation
    if bullishFlip
        pendingLong := true
        pendingShort := false
    else if bearishFlip
        pendingShort := true
        pendingLong := false

    if pendingLong and close < supertrend
        pendingLong := false

    if pendingShort and close > supertrend
        pendingShort := false
else
    pendingLong := bullishFlip
    pendingShort := bearishFlip

confirmedLong = pendingLong and close > supertrend
confirmedShort = pendingShort and close < supertrend

// ============================================================================
// DAILY P&L TRACKING
// ============================================================================

var float dayStartEquity = strategy.initial_capital
var int currentDay = 0

newDay = dayofmonth(time) != currentDay
if newDay
    dayStartEquity := strategy.equity
    currentDay := dayofmonth(time)

dailyPnL = strategy.equity - dayStartEquity
dailyPnLPercent = (dailyPnL / dayStartEquity) * 100

hitDailyTarget = enableDailyTarget and dailyPnLPercent >= dailyTarget
hitDailyStop = enableDailyStop and dailyPnLPercent <= -dailyStopLoss
dailyLimitReached = hitDailyTarget or hitDailyStop

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

longEntry = allowLong and confirmedLong and strategy.position_size == 0 and not dailyLimitReached
shortEntry = allowShort and confirmedShort and strategy.position_size == 0 and not dailyLimitReached

// Reset pending signals after entry
if longEntry
    pendingLong := false

if shortEntry
    pendingShort := false

// ============================================================================
// POSITION MANAGEMENT
// ============================================================================

var float entry = na
var float stopLoss = na
var float trailStop = na

if longEntry
    entry := close
    stopLoss := close * (1 - stopLossPercent / 100)
    trailStop := na
    strategy.entry("L", strategy.long)

if shortEntry
    entry := close
    stopLoss := close * (1 + stopLossPercent / 100)
    trailStop := na
    strategy.entry("S", strategy.short)

// ============================================================================
// TRAILING STOP
// ============================================================================

if strategy.position_size > 0 and useTrailingStop
    activationPrice = entry * (1 + trailActivation / 100)
    if close >= activationPrice
        newTrail = close * (1 - trailOffset / 100)
        trailStop := na(trailStop) ? newTrail : math.max(trailStop, newTrail)

if strategy.position_size < 0 and useTrailingStop
    activationPrice = entry * (1 - trailActivation / 100)
    if close <= activationPrice
        newTrail = close * (1 + trailOffset / 100)
        trailStop := na(trailStop) ? newTrail : math.min(trailStop, newTrail)

// ============================================================================
// EXIT MANAGEMENT
// ============================================================================

if strategy.position_size > 0
    if not na(trailStop)
        strategy.exit("X", "L", stop=math.max(stopLoss, trailStop))
    else
        strategy.exit("X", "L", stop=stopLoss)
    if bearishFlip
        strategy.close("L", comment="Reverse")
        trailStop := na
        pendingLong := false

if strategy.position_size < 0
    if not na(trailStop)
        strategy.exit("X", "S", stop=math.min(stopLoss, trailStop))
    else
        strategy.exit("X", "S", stop=stopLoss)
    if bullishFlip
        strategy.close("S", comment="Reverse")
        trailStop := na
        pendingShort := false

if dailyLimitReached and strategy.position_size != 0
    strategy.close_all(comment="Daily Limit")
    trailStop := na
    pendingLong := false
    pendingShort := false

// ============================================================================
// PLOTTING
// ============================================================================

plot(bullish ? supertrend : na, "Up", color.lime, 3)
plot(bearish ? supertrend : na, "Down", color.red, 3)

plotshape(longEntry, "Buy", shape.triangleup, location.belowbar, color.lime, size=size.normal, text="BUY")
plotshape(shortEntry, "Sell", shape.triangledown, location.abovebar, color.red, size=size.normal, text="SELL")

plotshape(useConfirmation and pendingLong and not confirmedLong, "Pending Buy", shape.circle, location.belowbar, color.new(color.yellow, 50), size=size.tiny, text="?")
plotshape(useConfirmation and pendingShort and not confirmedShort, "Pending Sell", shape.circle, location.abovebar, color.new(color.yellow, 50), size=size.tiny, text="?")

bgcolor(bullish ? color.new(color.lime, 95) : color.new(color.red, 95))

plot(strategy.position_size != 0 ? stopLoss : na, "SL", color.red, 2, plot.style_cross)
plot(strategy.position_size != 0 and not na(trailStop) ? trailStop : na, "Trail", color.orange, 2, plot.style_circles)

// ============================================================================
// DASHBOARD
// ============================================================================

if barstate.islast
    var t = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 90), border_width=1)

    table.cell(t, 0, 0, "V9a PLAN A", text_color=color.white, bgcolor=color.new(color.blue, 60))
    table.cell(t, 1, 0, "", bgcolor=color.new(color.blue, 60))

    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    wrCol = wr >= 60 ? color.lime : wr >= 55 ? color.yellow : wr >= 50 ? color.orange : color.red
    table.cell(t, 0, 1, "Win Rate", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(wr, "#.#") + "%", text_color=wrCol)

    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0
    pfCol = pf >= 3.0 ? color.lime : pf >= 2.5 ? color.yellow : pf >= 2.0 ? color.orange : color.red
    table.cell(t, 0, 2, "Profit Factor", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(pf, "#.##"), text_color=pfCol)

    table.cell(t, 0, 3, "Trades", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white)

    profit = (strategy.netprofit / strategy.initial_capital) * 100
    profCol = profit >= 25 ? color.lime : profit >= 20 ? color.yellow : profit >= 15 ? color.orange : profit > 0 ? color.gray : color.red
    table.cell(t, 0, 4, "Profit %", text_color=color.white)
    table.cell(t, 1, 4, str.tostring(profit, "#.#") + "%", text_color=profCol)

    dd = strategy.max_drawdown / strategy.initial_capital * 100
    ddCol = dd < 8 ? color.lime : dd < 12 ? color.yellow : dd < 15 ? color.orange : color.red
    table.cell(t, 0, 5, "Max DD", text_color=color.white)
    table.cell(t, 1, 5, str.tostring(dd, "#.#") + "%", text_color=ddCol)

    avgWin = strategy.wintrades > 0 ? (strategy.grossprofit / strategy.wintrades / strategy.initial_capital * 100) : 0
    table.cell(t, 0, 6, "Avg Win %", text_color=color.white)
    table.cell(t, 1, 6, str.tostring(avgWin, "#.##") + "%", text_color=color.lime)

    avgLoss = strategy.losstrades > 0 ? (strategy.grossloss / strategy.losstrades / strategy.initial_capital * 100) : 0
    table.cell(t, 0, 7, "Avg Loss %", text_color=color.white)
    table.cell(t, 1, 7, str.tostring(avgLoss, "#.##") + "%", text_color=color.red)

    table.cell(t, 0, 8, "Trend", text_color=color.white)
    table.cell(t, 1, 8, bullish ? "BULL" : "BEAR", text_color=bullish ? color.lime : color.red)

    pos = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "NONE"
    posCol = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(t, 0, 9, "Position", text_color=color.white)
    table.cell(t, 1, 9, pos, text_color=posCol)

    dpCol = dailyPnLPercent >= dailyTarget ? color.lime : dailyPnLPercent >= 0 ? color.yellow : dailyPnLPercent <= -dailyStopLoss ? color.red : color.orange
    table.cell(t, 0, 10, "Daily P&L", text_color=color.white)
    table.cell(t, 1, 10, str.tostring(dailyPnLPercent, "#.##") + "%", text_color=dpCol)

    conf = useConfirmation ? (pendingLong or pendingShort ? "PENDING" : "READY") : "OFF"
    confCol = pendingLong or pendingShort ? color.yellow : color.gray
    table.cell(t, 0, 11, "Confirmation", text_color=color.white)
    table.cell(t, 1, 11, conf, text_color=confCol)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longEntry, "LONG", "Buy XAUUSD @ {{close}}")
alertcondition(shortEntry, "SHORT", "Sell XAUUSD @ {{close}}")
alertcondition(bearishFlip and strategy.position_size > 0, "Exit Long", "Close Long @ {{close}}")
alertcondition(bullishFlip and strategy.position_size < 0, "Exit Short", "Close Short @ {{close}}")
